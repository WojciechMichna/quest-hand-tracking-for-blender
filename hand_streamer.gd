extends Node
class_name HandStreamer
## Streams head, wrists, finger joints (QHND) and Meta body tracking (QBDY) over UDP.
## Reads live OpenXR joints directly from XRHandTracker / XRBodyTracker.
##
## The packets are built on the main thread straight into PackedFloat32Array / PackedByteArray in
## the wire layout (no Dictionaries per joint), the worker thread only sends them.

@export var enabled: bool = true
@export var target_ip: String = "192.168.0.223"
@export var target_port: int = 5005
@export var enable_broadcast: bool = false

# --- Binary format QHND v1 (little-endian) -----------------------------------
# header (12 B): "QHND" | u8 version=1 | u8 flags | u16 joint_count | u32 time_ms
#   flags: bit0 head, bit1 left hand, bit2 right hand, bit3 model_rot blocks present
# head  (28 B): pos xyz f32, rot xyzw f32                       (only if bit0)
# hand  (for each present hand, left first, then right):
#   u32 valid_mask (bit i = joint i has valid orientation+position, joint order = FINGER_CHAINS)
#   wrist pos xyz f32, rot xyzw f32                               (28 B)
#   joint_count x (rot xyzw f32, pos xyz f32)                     (24 x 28 B)
#   if bit3: joint_count x model_rot xyzw f32                     (24 x 16 B)
# joint rot/pos = relative to the parent joint (metacarpals: to the wrist), like BONE_UPDATE_FULL.
const QHND_MAGIC := "QHND"
const QHND_VERSION := 1

# --- Body: separate datagram QBDY v1 (little-endian), sent right after the QHND packet ----------
# header (12 B): "QBDY" | u8 version=1 | u8 flags | u16 joint_count | u32 time_ms
#   flags: bit0 lower body (legs) supported, bit1 high fidelity (IOBT) active
# u32 valid_mask   (bit i = joint i has valid orientation+position)
# u32 tracked_mask (bit i = joint i is really tracked; valid but not tracked = generated by Meta, e.g. legs)
# joint_count x (rot xyzw f32, pos xyz f32)  - joint pose in room space (recentered), Godot humanoid axes
# Joint order = BODY_JOINTS (names = Godot SkeletonProfileHumanoid bone names). 22 joints -> 636 B.
const QBDY_MAGIC := "QBDY"
const QBDY_VERSION := 1

# --- Control: QCTL v1 (little-endian, 16 B), sent from the main thread when the user presses a
# button in VR. "QCTL" | u8 version=1 | u8 command | u16 reserved | u32 time_ms | u32 seq
# Sent CTRL_REPEAT times with the same seq (UDP may drop one); the receiver ignores repeats.
const QCTL_MAGIC := "QCTL"
const QCTL_VERSION := 1
const CTRL_RECORD_START := 1
const CTRL_RECORD_STOP := 2
const CTRL_REPEAT := 3
var _ctrl_udp: PacketPeerUDP = null
var _ctrl_seq: int = 0

const BODY_JOINTS := [
	["Hips", XRBodyTracker.JOINT_HIPS], ["Spine", XRBodyTracker.JOINT_SPINE],
	["Chest", XRBodyTracker.JOINT_CHEST], ["UpperChest", XRBodyTracker.JOINT_UPPER_CHEST],
	["Neck", XRBodyTracker.JOINT_NECK], ["Head", XRBodyTracker.JOINT_HEAD],
	["LeftShoulder", XRBodyTracker.JOINT_LEFT_SHOULDER], ["LeftUpperArm", XRBodyTracker.JOINT_LEFT_UPPER_ARM],
	["LeftLowerArm", XRBodyTracker.JOINT_LEFT_LOWER_ARM], ["LeftHand", XRBodyTracker.JOINT_LEFT_HAND],
	["RightShoulder", XRBodyTracker.JOINT_RIGHT_SHOULDER], ["RightUpperArm", XRBodyTracker.JOINT_RIGHT_UPPER_ARM],
	["RightLowerArm", XRBodyTracker.JOINT_RIGHT_LOWER_ARM], ["RightHand", XRBodyTracker.JOINT_RIGHT_HAND],
	["LeftUpperLeg", XRBodyTracker.JOINT_LEFT_UPPER_LEG], ["LeftLowerLeg", XRBodyTracker.JOINT_LEFT_LOWER_LEG],
	["LeftFoot", XRBodyTracker.JOINT_LEFT_FOOT], ["LeftToes", XRBodyTracker.JOINT_LEFT_TOES],
	["RightUpperLeg", XRBodyTracker.JOINT_RIGHT_UPPER_LEG], ["RightLowerLeg", XRBodyTracker.JOINT_RIGHT_LOWER_LEG],
	["RightFoot", XRBodyTracker.JOINT_RIGHT_FOOT], ["RightToes", XRBodyTracker.JOINT_RIGHT_TOES],
]
## Stream Meta body tracking (upper body tracked by the cameras, legs generated) as QBDY packets.
@export var send_body: bool = true
## Ask Meta for high fidelity body tracking (Inside-Out Body Tracking, Quest 3).
@export var body_high_fidelity: bool = true
var _body_ext: Object = null
var _body_fidelity_asked: bool = false
const _JOINT_VALID := XRHandTracker.HAND_JOINT_FLAG_ORIENTATION_VALID | XRHandTracker.HAND_JOINT_FLAG_POSITION_VALID
const _BODY_VALID := XRBodyTracker.JOINT_FLAG_ORIENTATION_VALID | XRBodyTracker.JOINT_FLAG_POSITION_VALID
const _BODY_TRACKED := XRBodyTracker.JOINT_FLAG_ORIENTATION_TRACKED | XRBodyTracker.JOINT_FLAG_POSITION_TRACKED

var xr_camera: XRCamera3D
var left_hand_node: XRNode3D
var right_hand_node: XRNode3D
var left_skeleton: Skeleton3D
var right_skeleton: Skeleton3D

# Finger chains (OpenXR humanoid naming). The order of the joints in the packet = this order.
const FINGER_CHAINS := {
	"thumb": ["ThumbMetacarpal", "ThumbProximal", "ThumbDistal", "ThumbTip"],
	"index": ["IndexMetacarpal", "IndexProximal", "IndexIntermediate", "IndexDistal", "IndexTip"],
	"middle": ["MiddleMetacarpal", "MiddleProximal", "MiddleIntermediate", "MiddleDistal", "MiddleTip"],
	"ring": ["RingMetacarpal", "RingProximal", "RingIntermediate", "RingDistal", "RingTip"],
	"little": ["LittleMetacarpal", "LittleProximal", "LittleIntermediate", "LittleDistal", "LittleTip"]
}

# Bone short name -> OpenXR hand joint
const JOINT_MAP := {
	"ThumbMetacarpal": XRHandTracker.HAND_JOINT_THUMB_METACARPAL,
	"ThumbProximal": XRHandTracker.HAND_JOINT_THUMB_PHALANX_PROXIMAL,
	"ThumbDistal": XRHandTracker.HAND_JOINT_THUMB_PHALANX_DISTAL,
	"ThumbTip": XRHandTracker.HAND_JOINT_THUMB_TIP,
	"IndexMetacarpal": XRHandTracker.HAND_JOINT_INDEX_FINGER_METACARPAL,
	"IndexProximal": XRHandTracker.HAND_JOINT_INDEX_FINGER_PHALANX_PROXIMAL,
	"IndexIntermediate": XRHandTracker.HAND_JOINT_INDEX_FINGER_PHALANX_INTERMEDIATE,
	"IndexDistal": XRHandTracker.HAND_JOINT_INDEX_FINGER_PHALANX_DISTAL,
	"IndexTip": XRHandTracker.HAND_JOINT_INDEX_FINGER_TIP,
	"MiddleMetacarpal": XRHandTracker.HAND_JOINT_MIDDLE_FINGER_METACARPAL,
	"MiddleProximal": XRHandTracker.HAND_JOINT_MIDDLE_FINGER_PHALANX_PROXIMAL,
	"MiddleIntermediate": XRHandTracker.HAND_JOINT_MIDDLE_FINGER_PHALANX_INTERMEDIATE,
	"MiddleDistal": XRHandTracker.HAND_JOINT_MIDDLE_FINGER_PHALANX_DISTAL,
	"MiddleTip": XRHandTracker.HAND_JOINT_MIDDLE_FINGER_TIP,
	"RingMetacarpal": XRHandTracker.HAND_JOINT_RING_FINGER_METACARPAL,
	"RingProximal": XRHandTracker.HAND_JOINT_RING_FINGER_PHALANX_PROXIMAL,
	"RingIntermediate": XRHandTracker.HAND_JOINT_RING_FINGER_PHALANX_INTERMEDIATE,
	"RingDistal": XRHandTracker.HAND_JOINT_RING_FINGER_PHALANX_DISTAL,
	"RingTip": XRHandTracker.HAND_JOINT_RING_FINGER_TIP,
	"LittleMetacarpal": XRHandTracker.HAND_JOINT_PINKY_FINGER_METACARPAL,
	"LittleProximal": XRHandTracker.HAND_JOINT_PINKY_FINGER_PHALANX_PROXIMAL,
	"LittleIntermediate": XRHandTracker.HAND_JOINT_PINKY_FINGER_PHALANX_INTERMEDIATE,
	"LittleDistal": XRHandTracker.HAND_JOINT_PINKY_FINGER_PHALANX_DISTAL,
	"LittleTip": XRHandTracker.HAND_JOINT_PINKY_FINGER_TIP,
}

# Lookup tables in packet order, built once in _init_tables()
var _hand_joint := PackedInt32Array()     # tracker joint of packet joint i
var _hand_parent := PackedInt32Array()    # its parent joint (wrist for metacarpals)
var _hand_name := PackedStringArray()     # short bone name (skeleton fallback, model bones)
var _parent_joints := PackedInt32Array()  # distinct parents -> inverse transforms needed
var _body_joint := PackedInt32Array()
var _joint_xf: Array[Transform3D] = []    # scratch: tracker transforms of one hand
var _joint_inv: Array[Transform3D] = []
var _joint_flags := PackedInt32Array()

# Thread synchronization: Producer (main thread) -> Consumer (worker), strictly latest packets, no queue
var _mutex: Mutex = Mutex.new()
var _semaphore: Semaphore = Semaphore.new()
var _thread: Thread = Thread.new()
var _running: bool = false
var _out_hands := PackedByteArray()
var _out_body := PackedByteArray()
var _has_new: bool = false

# DEBUG: headset model bone rotations (after XRHandModifier3D), for comparison in Blender (+384 B per hand).
@export var send_model_bones: bool = false
var _model_rot := {"Left": {}, "Right": {}}    # prefix -> {short_name: Quaternion}
var _bone_idx := {"Left": {}, "Right": {}}     # prefix -> {short_name: bone index}

# --- Recenter -----------------------------------------------------------------
# Everything we send (head, wrists, body) is expressed relative to where the user stood and
# looked when streaming started: that spot = origin on the floor, view direction = -Z.
# Without it the origin is wherever the Quest put its floor origin (headset on the desk
# when the app was launched, a redrawn boundary...).
## Recenter automatically once the head is tracked after start, and on the system recenter (hold Meta button).
@export var auto_recenter: bool = true
var _center: Transform3D = Transform3D.IDENTITY
var _recenter_pending: bool = true
var _recenter_delay: float = 0.5     # seconds of valid head tracking before the first recenter


## Sends a control command (CTRL_RECORD_START / CTRL_RECORD_STOP) to the PC.
func send_control(command: int) -> void:
	if _ctrl_udp == null:
		_ctrl_udp = PacketPeerUDP.new()
		if enable_broadcast:
			_ctrl_udp.set_broadcast_enabled(true)
			_ctrl_udp.set_dest_address("255.255.255.255", target_port)
		else:
			_ctrl_udp.set_dest_address(target_ip, target_port)
	_ctrl_seq += 1
	var pkt := _header(QCTL_MAGIC, QCTL_VERSION, command, 0, Time.get_ticks_msec(), 16)
	pkt.encode_u32(12, _ctrl_seq)
	for i in range(CTRL_REPEAT):
		_ctrl_udp.put_packet(pkt)
	print("[HandStreamer] CTRL ", command, " seq ", _ctrl_seq)


## Makes the current headset position (on the floor) + yaw the new origin of the sent data.
func recenter() -> void:
	if not xr_camera:
		return
	var ht: Transform3D = xr_camera.transform
	var f: Vector3 = -ht.basis.z
	f.y = 0.0
	if f.length_squared() < 1e-6:
		f = ht.basis.y        # looking straight down/up: use the head's up axis
		f.y = 0.0
	if f.length_squared() < 1e-6:
		return
	var origin := Vector3(ht.origin.x, 0.0, ht.origin.z)
	_center = Transform3D(Basis.looking_at(f.normalized(), Vector3.UP), origin).affine_inverse()
	_recenter_pending = false
	print("[HandStreamer] Recentered at ", origin)


func _on_pose_recentered() -> void:
	# The Quest moved its own origin; our stored offset is stale -> recenter on the next frame.
	_recenter_pending = true
	_recenter_delay = 0.0


func _init_tables() -> void:
	for finger in FINGER_CHAINS.keys():
		for short in FINGER_CHAINS[finger]:
			var j: int = JOINT_MAP[short]
			_hand_joint.append(j)
			_hand_name.append(short)
			var p: int = _parent_of(j)
			_hand_parent.append(p)
			if not _parent_joints.has(p):
				_parent_joints.append(p)
	for e in BODY_JOINTS:
		_body_joint.append(e[1])
	_joint_xf.resize(XRHandTracker.HAND_JOINT_MAX)
	_joint_inv.resize(XRHandTracker.HAND_JOINT_MAX)
	_joint_flags.resize(XRHandTracker.HAND_JOINT_MAX)


## OpenXR hand hierarchy: metacarpal -> wrist, every other joint -> the previous joint of its finger.
static func _parent_of(j: int) -> int:
	match j:
		XRHandTracker.HAND_JOINT_THUMB_METACARPAL, XRHandTracker.HAND_JOINT_INDEX_FINGER_METACARPAL, \
		XRHandTracker.HAND_JOINT_MIDDLE_FINGER_METACARPAL, XRHandTracker.HAND_JOINT_RING_FINGER_METACARPAL, \
		XRHandTracker.HAND_JOINT_PINKY_FINGER_METACARPAL:
			return XRHandTracker.HAND_JOINT_WRIST
	return j - 1


func _ready() -> void:
	_init_tables()
	_load_config()

	var origin: XROrigin3D = get_parent() if get_parent() is XROrigin3D else get_node_or_null("../XROrigin3D")
	if not origin:
		origin = get_tree().root.find_child("XROrigin3D", true, false)
	if origin:
		xr_camera = origin.find_child("XRCamera3D", true, false) as XRCamera3D
		left_hand_node = origin.find_child("LeftHand", true, false) as XRNode3D
		right_hand_node = origin.find_child("RightHand", true, false) as XRNode3D

	set_process(true)

	var xri := XRServer.find_interface("OpenXR")
	if xri and xri.has_signal("pose_recentered"):
		xri.connect("pose_recentered", _on_pose_recentered)

	if enabled:
		_running = true
		_thread.start(_consumer_thread_func)
		print("[HandStreamer] Consumer thread started. Target: %s:%d" % [target_ip, target_port])


func _load_config() -> void:
	var cfg_path := "user://stream_config.json"
	if FileAccess.file_exists(cfg_path):
		var file := FileAccess.open(cfg_path, FileAccess.READ)
		if file:
			var json = JSON.parse_string(file.get_as_text())
			if json is Dictionary:
				if json.has("target_ip"):
					target_ip = str(json["target_ip"])
				if json.has("target_port"):
					target_port = int(json["target_port"])
				if json.has("enable_broadcast"):
					enable_broadcast = bool(json["enable_broadcast"])
				print("[HandStreamer] Config loaded from user://: ", target_ip, ":", target_port)
	else:
		var save_file := FileAccess.open(cfg_path, FileAccess.WRITE)
		if save_file:
			save_file.store_string(JSON.stringify({"target_ip": target_ip, "target_port": target_port,
					"enable_broadcast": enable_broadcast}, "\t"))


func _cache_skeletons() -> void:
	if not left_skeleton and left_hand_node:
		left_skeleton = _find_skeleton(left_hand_node)
		if left_skeleton:
			print("[HandStreamer] Left skeleton found: %d bones" % left_skeleton.get_bone_count())
			_hook_skeleton(left_skeleton, "Left")
	if not right_skeleton and right_hand_node:
		right_skeleton = _find_skeleton(right_hand_node)
		if right_skeleton:
			print("[HandStreamer] Right skeleton found: %d bones" % right_skeleton.get_bone_count())
			_hook_skeleton(right_skeleton, "Right")


func _hook_skeleton(skel: Skeleton3D, prefix: String) -> void:
	var idx := {}
	for short in JOINT_MAP.keys():
		var b := skel.find_bone(prefix + short)
		if b != -1:
			idx[short] = b
	_bone_idx[prefix] = idx
	# The pose is final (after modifiers such as XRHandModifier3D) only in this signal.
	if skel.has_signal("skeleton_updated"):
		skel.skeleton_updated.connect(_on_skeleton_updated.bind(skel, prefix))
	print("[HandStreamer] %s model bones hooked: %d" % [prefix, idx.size()])


func _on_skeleton_updated(skel: Skeleton3D, prefix: String) -> void:
	if not send_model_bones:
		return
	var out := {}
	var idx: Dictionary = _bone_idx[prefix]
	for short in idx.keys():
		out[short] = skel.get_bone_pose_rotation(idx[short])
	_model_rot[prefix] = out


func _find_skeleton(n: Node) -> Skeleton3D:
	if n is Skeleton3D:
		return n
	for c in n.get_children():
		var s := _find_skeleton(c)
		if s:
			return s
	return null


# --- PRODUCER (main VR thread, every frame) ---
func _process(delta: float) -> void:
	if not enabled or not _running:
		return
	if not left_skeleton or not right_skeleton:
		_cache_skeletons()
	if auto_recenter and _recenter_pending and xr_camera and xr_camera.transform != Transform3D.IDENTITY:
		_recenter_delay -= delta
		if _recenter_delay <= 0.0:
			recenter()

	var time_ms: int = Time.get_ticks_msec()
	var hands := build_hand_packet(time_ms)
	var body := build_body_packet(time_ms) if send_body else PackedByteArray()

	# hand over the newest packets (an unsent older pair is simply replaced)
	_mutex.lock()
	_out_hands = hands
	_out_body = body
	_has_new = true
	_mutex.unlock()
	_semaphore.post()


## QHND packet of the current frame.
func build_hand_packet(time_ms: int) -> PackedByteArray:
	var flags := 0
	var head := PackedFloat32Array()
	if xr_camera:
		flags |= 1
		_put_pos_rot(head, _center * xr_camera.transform)
	var left := _hand_block(XRServer.get_tracker(&"/user/hand_tracker/left"), "Left", left_hand_node, left_skeleton)
	var right := _hand_block(XRServer.get_tracker(&"/user/hand_tracker/right"), "Right", right_hand_node, right_skeleton)
	if not left.is_empty():
		flags |= 2
	if not right.is_empty():
		flags |= 4
	if send_model_bones and (flags & 6):
		flags |= 8
	var pkt := _header(QHND_MAGIC, QHND_VERSION, flags, _hand_joint.size(), time_ms, 12)
	if flags & 1:
		pkt.append_array(head.to_byte_array())
	pkt.append_array(left)
	pkt.append_array(right)
	return pkt


## One hand: u32 valid mask, wrist, joints (+ model rotations). Empty = hand not sent.
func _hand_block(tracker, prefix: String, hand_node: XRNode3D, skeleton: Skeleton3D) -> PackedByteArray:
	var n := _hand_joint.size()
	var f := PackedFloat32Array()
	var mask := 0
	if tracker is XRHandTracker:
		if not tracker.has_tracking_data:
			return PackedByteArray()
		for j in range(XRHandTracker.HAND_JOINT_MAX):
			_joint_xf[j] = tracker.get_hand_joint_transform(j)
			_joint_flags[j] = tracker.get_hand_joint_flags(j)
		for p in _parent_joints:
			_joint_inv[p] = _joint_xf[p].affine_inverse()
		var wt: Transform3D = _joint_xf[XRHandTracker.HAND_JOINT_WRIST]
		if wt == Transform3D.IDENTITY and hand_node:
			wt = hand_node.transform
		_put_pos_rot(f, _center * wt)
		for i in range(n):
			var j: int = _hand_joint[i]
			var p: int = _hand_parent[i]
			var rel: Transform3D = _joint_inv[p] * _joint_xf[j]
			_put_rot_pos(f, rel.basis.get_rotation_quaternion(), rel.origin)
			if (_joint_flags[j] & _JOINT_VALID) == _JOINT_VALID and (_joint_flags[p] & _JOINT_VALID) == _JOINT_VALID:
				mask |= 1 << i
	elif skeleton and hand_node:
		# no hand tracker (e.g. controllers): skeleton pose of the hand model
		_put_pos_rot(f, _center * hand_node.transform)
		var idx: Dictionary = _bone_idx[prefix]
		for i in range(n):
			var b: int = idx.get(_hand_name[i], -1)
			if b == -1:
				_put_rot_pos(f, Quaternion.IDENTITY, Vector3.ZERO)
			else:
				_put_rot_pos(f, skeleton.get_bone_pose_rotation(b), skeleton.get_bone_pose_position(b))
				mask |= 1 << i
	else:
		return PackedByteArray()
	if send_model_bones:
		var mr: Dictionary = _model_rot[prefix]
		for i in range(n):
			var q = mr.get(_hand_name[i])
			if q == null:      # no model bone: repeat the tracked rotation
				var o := 7 + i * 7
				f.append_array(f.slice(o, o + 4))
			else:
				f.append(q.x); f.append(q.y); f.append(q.z); f.append(q.w)
	var out := PackedByteArray()
	out.resize(4)
	out.encode_u32(0, mask)
	out.append_array(f.to_byte_array())
	return out


## QBDY packet of the current frame (empty when body tracking has no data).
func build_body_packet(time_ms: int) -> PackedByteArray:
	var bt = XRServer.get_tracker(&"/user/body_tracker")
	if bt == null or not bt.has_tracking_data:
		return PackedByteArray()
	if body_high_fidelity and not _body_fidelity_asked:
		_body_fidelity_asked = true
		if Engine.has_singleton("OpenXRFbBodyTrackingExtension"):
			_body_ext = Engine.get_singleton("OpenXRFbBodyTrackingExtension")
		if _body_ext and _body_ext.has_method("is_body_tracking_fidelity_supported") \
				and _body_ext.is_body_tracking_fidelity_supported():
			_body_ext.request_body_tracking_fidelity(2)   # BODY_TRACKING_FIDELITY_HIGH
			print("[HandStreamer] Body tracking: requested HIGH fidelity")
	var flags := 0
	if int(bt.body_flags) & XRBodyTracker.BODY_FLAG_LOWER_BODY_SUPPORTED:
		flags |= 1
	if _body_ext and _body_ext.has_method("get_body_tracking_fidelity_status") \
			and int(_body_ext.get_body_tracking_fidelity_status()) == 2:
		flags |= 2
	var valid := 0
	var tracked := 0
	var f := PackedFloat32Array()
	for i in range(_body_joint.size()):
		var j: int = _body_joint[i]
		var fl: int = bt.get_joint_flags(j)
		if (fl & _BODY_VALID) == _BODY_VALID:
			valid |= 1 << i
		if (fl & _BODY_TRACKED) == _BODY_TRACKED:
			tracked |= 1 << i
		var t: Transform3D = _center * bt.get_joint_transform(j)
		_put_rot_pos(f, t.basis.get_rotation_quaternion(), t.origin)
	var pkt := _header(QBDY_MAGIC, QBDY_VERSION, flags, _body_joint.size(), time_ms, 20)
	pkt.encode_u32(12, valid)
	pkt.encode_u32(16, tracked)
	pkt.append_array(f.to_byte_array())
	return pkt


## magic(4) u8 version u8 flags u16 count u32 time, buffer sized to `size` bytes (rest zero).
static func _header(magic: String, version: int, flags: int, count: int, time_ms: int, size: int) -> PackedByteArray:
	var b := magic.to_ascii_buffer()
	b.resize(size)
	b.encode_u8(4, version)
	b.encode_u8(5, flags)
	b.encode_u16(6, count)
	b.encode_u32(8, time_ms & 0xFFFFFFFF)
	return b


static func _put_pos_rot(f: PackedFloat32Array, t: Transform3D) -> void:
	var q := t.basis.get_rotation_quaternion()
	f.append(t.origin.x); f.append(t.origin.y); f.append(t.origin.z)
	f.append(q.x); f.append(q.y); f.append(q.z); f.append(q.w)


static func _put_rot_pos(f: PackedFloat32Array, q: Quaternion, p: Vector3) -> void:
	f.append(q.x); f.append(q.y); f.append(q.z); f.append(q.w)
	f.append(p.x); f.append(p.y); f.append(p.z)


# --- CONSUMER (worker thread: sends only the newest packets) ---
func _consumer_thread_func() -> void:
	var udp := PacketPeerUDP.new()
	if enable_broadcast:
		udp.set_broadcast_enabled(true)
		udp.set_dest_address("255.255.255.255", target_port)
	else:
		udp.set_dest_address(target_ip, target_port)

	while _running:
		_semaphore.wait()
		if not _running:
			break
		var hands := PackedByteArray()
		var body := PackedByteArray()
		_mutex.lock()
		if _has_new:
			hands = _out_hands
			body = _out_body
			_has_new = false
		_mutex.unlock()
		if not hands.is_empty():
			udp.put_packet(hands)
		if not body.is_empty():
			udp.put_packet(body)
	udp.close()


func _exit_tree() -> void:
	if _ctrl_udp:
		_ctrl_udp.close()
	if _running:
		_running = false
		_semaphore.post()
		if _thread.is_started():
			_thread.wait_to_finish()
		print("[HandStreamer] Worker thread terminated cleanly.")
